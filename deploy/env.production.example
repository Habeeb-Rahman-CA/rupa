# =============================================================================
# Rupa — NestJS Backend Production Configuration
# =============================================================================
# Copy to .env.production and fill in all values before deploying.
# Never commit real secrets to version control.

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=/api
APP_TIME_ZONE=Asia/Kolkata

# Database (PostgreSQL)
DATABASE_URL=postgresql://rupa_app:<strong-password>@<db-host>:5433/rupa?sslmode=require

# JWT (rotate these before production — never reuse dev values)
JWT_ACCESS_SECRET=<32+ random chars>
JWT_REFRESH_SECRET=<32+ random chars>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cookie settings
COOKIE_DOMAIN=<your-production-domain>
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=<base64url public key>
VAPID_PRIVATE_KEY=<base64url private key — NEVER expose to frontend>
VAPID_SUBJECT=https://<your-production-domain>
PUSH_CRON_SECRET=<32+ random hex chars — used by x-cron-secret header>
PUSH_RENEWAL_WINDOW_DAYS=3

# CORS (restrict to production frontend origin)
CORS_ORIGIN=https://<your-vercel-app>.vercel.app

# Observability (NestJS Observe)
OBSERVE_APP_KEY=<observe-app-key>
OBSERVE_APP_SECRET=<observe-app-secret>

# =============================================================================
# End of .env.production
# =============================================================================
