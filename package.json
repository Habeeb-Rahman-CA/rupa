{
  "name": "rupa",
  "version": "1.0.6",
  "description": "rūpa — a fast personal expense tracker (PWA)",
  "author": "Habeeb Rahman",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:host": "ng serve --host 0.0.0.0 --disable-host-check",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "preview": "ng serve --configuration production",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "lint": "npm run typecheck",
    "icons": "powershell -ExecutionPolicy Bypass -File ./scripts/gen-icons.ps1",
    "icons:linux": "magick convert public/rupa-icon.png -resize 72x72 public/icons/icon-72x72.png && magick convert public/rupa-icon.png -resize 96x96 public/icons/icon-96x96.png && magick convert public/rupa-icon.png -resize 128x128 public/icons/icon-128x128.png && magick convert public/rupa-icon.png -resize 144x144 public/icons/icon-144x144.png && magick convert public/rupa-icon.png -resize 152x152 public/icons/icon-152x152.png && magick convert public/rupa-icon.png -resize 192x192 public/icons/icon-192x192.png && magick convert public/rupa-icon.png -resize 384x384 public/icons/icon-384x384.png && magick convert public/rupa-icon.png -resize 512x512 public/icons/icon-512x512.png && magick convert public/rupa-icon.png -resize 180x180 public/apple-touch-icon.png",
    "clean": "rm -rf dist ./.angular",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "heic-decode": "^2.1.0",
    "heic2any": "^0.0.4",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.1",
    "@angular/cli": "^20.3.1",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.4",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
